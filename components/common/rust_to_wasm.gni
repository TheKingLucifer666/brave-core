import("//brave/tools/crates/wasm_pack/sources.gni")

template("rust_to_wasm") {
  assert(defined(invoker.rust_packages),
         "Need rust_packages in $target_name listing the Config.toml files.")
  if (defined(invoker.wasm_pack_target)) {
    assert(invoker.wasm_pack_target == "bundler" ||
               invoker.wasm_pack_target == "nodejs" ||
               invoker.wasm_pack_target == "web",
           "${invoker.wasm_pack_target} is not a supported wasm-pack target.")
  }

  action_foreach(target_name) {
    deps = [ "//brave/tools/crates/wasm_pack:build_wasm_pack($host_toolchain)" ]
    if (defined(invoker.deps)) {
      deps += invoker.deps
    }

    inputs = [ wasm_pack_exe ]
    sources = invoker.rust_packages
    inputs += sources

    script = "//build/gn_run_binary.py"

    wasm_pack_target = "bundler"
    if (defined(invoker.wasm_pack_target)) {
      wasm_pack_target = invoker.wasm_pack_target
    }

    args = [
      rebase_path(wasm_pack_exe),
      "build",
      "{{source_dir}}",
      "--target",
      wasm_pack_target,
      "--out-dir",
      rebase_path("$root_out_dir/{{source_gen_dir}}/$wasm_pack_target/pkg"),
      "--out-name",
      "index",
      "--",
      "--target-dir",
      rebase_path("$root_out_dir/{{source_gen_dir}}/$wasm_pack_target/target"),
    ]

    # common output files for all the wasm-pack targets
    outputs = [
      "{{source_gen_dir}}/$wasm_pack_target/pkg/index_bg.wasm",
      "{{source_gen_dir}}/$wasm_pack_target/pkg/index_bg.wasm.d.ts",
      "{{source_gen_dir}}/$wasm_pack_target/pkg/index.d.ts",
      "{{source_gen_dir}}/$wasm_pack_target/pkg/index.js",
      "{{source_gen_dir}}/$wasm_pack_target/pkg/package.json",
    ]

    # additional output file for the bundler wasm-pack target
    if (wasm_pack_target == "bundler") {
      outputs += [ "{{source_gen_dir}}/$wasm_pack_target/pkg/index_bg.js" ]
    }
  }
}
